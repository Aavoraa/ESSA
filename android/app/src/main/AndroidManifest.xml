<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Essa"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- configChanges: every change the WebView can simply re-lay out for.
             Without one, Android destroys the activity and the page reloads from
             /m, losing whatever was half-entered. The ones that bit: `keyboard` —
             a Bluetooth barcode scanner connects as a hardware keyboard, so
             pairing one mid-GRN wiped the screen; `smallestScreenSize` and
             `screenLayout` — unfolding a foldable or resizing split-screen;
             `uiMode` — the phone switching to dark mode at sunset.
             No screenOrientation here: phones are held to portrait in
             MainActivity, and tablets rotate (Android 16 ignores an orientation
             lock on large screens anyway). adjustResize keeps a field the
             keyboard would cover scrolled into view. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:label="@string/setup_title" />

        <!-- Lets the camera app write into this app's cache and hand the photo
             back. Without it, MediaStore.EXTRA_OUTPUT can only point at a file
             the camera has no permission to open, and "Take a photo" fails
             after the shutter rather than before it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
